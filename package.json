{
  "name": "silver-frontend-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dev:backend": "cd backend && python -m uvicorn websocket_server:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "next dev",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "setup:backend": "cd backend && python -m venv venv && venv\\Scripts\\activate && pip install -r requirements.txt",
    "typecheck": "next typegen && tsc --noEmit",
    "test:security": "node --test tests/mongodb-configuration.test.mjs",
    "test:glob-adapter": "node --test tests/next-glob-adapter.test.mjs tests/next-eslint-configuration.test.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.513.0",
    "mongodb": "^6.17.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5",
    "braces": "file:./tools/next-eslint-braces"
  },
  "overrides": {
    "postcss": "8.5.29",
    "micromatch@4.0.8": {
      "braces": "$braces"
    }
  }
}
